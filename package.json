{
  "private": true,
  "sideEffects": false,
  "scripts": {
    "build:base": "next build",
    "build": "bun run generate:all && bun run build:base",
    "dev": "SHOW_TEST_PAGES=true bun run generate:all && next dev",
    "start": "netlify serve",
    "next:start": "next start",
    "lint": "oxlint",
    "types": "tsc",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "clean": "rm -rf .next src/generated/**/*",
    "generate:all": "bun run clean && bun run generate:mdx && bun run generate:mdxjson && bun run generate:imagebarrel && bun run generate:rss && bun run generate:sitemap",
    "generate:mdxjson": "rm -rf src/generated/frontmatter && bun utils/extractFrontMatter.bin.ts",
    "generate:imagebarrel": "bun utils/generateImageBarrelFiles.ts",
    "generate:rss": "bun utils/generateRss.ts",
    "generate:sitemap": "bun utils/generateSitemap.ts",
    "generate:mdx": "bun utils/transformMdx.bin.ts",
    "test": "bun test ./utils ./src",
    "test:watch": "bun test --watch ./utils ./src"
  },
  "dependencies": {
    "@blacksheepcode/example-react-autocomplete": "git+https://github.com/dwjohnston/example-react-autocomplete.git#c8e74acf9d10aef0dfc2b6f6d33ee811371ab99a",
    "@blacksheepcode/react-text-highlight": "^0.4.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@netlify/plugin-nextjs": "^5.16.5",
    "@next/mdx": "^16.4.3",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@sentry/nextjs": "^11.10.0",
    "@types/mdx": "^2.0.14",
    "front-matter": "^4.0.2",
    "human-readable-ids": "^1.0.4",
    "image-size": "^2.0.4",
    "import-in-the-middle": "^3.5.3",
    "js-cookie": "^3.0.8",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-github-permalink": "^1.11.1",
    "react-responsive": "^10.0.1",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^6.0.0",
    "require-in-the-middle": "^8.0.1",
    "usehooks-ts": "^3.1.1",
    "vfile-matter": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/fs-extra": "^11.0.4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "fs-extra": "^11.4.1",
    "oxlint": "^1.90.0",
    "sentry-upload-sourcemaps": "^8.13.1",
    "typescript": "^6"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "@blacksheepcode/example-react-autocomplete",
    "@sentry/cli",
    "esbuild",
    "sharp"
  ],
  "patchedDependencies": {
    "example-react-autocomplete@github:dwjohnston/example-react-autocomplete#c8e74acf9d10aef0dfc2b6f6d33ee811371ab99a": "patches/example-react-autocomplete@github%3Adwjohnston%2Fexample-react-autocomplete#c8e74acf9d10aef0dfc2b6f6d33ee811371ab99a.patch"
  }
}
