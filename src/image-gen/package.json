{
  "name": "blacksheepcode-image-gen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Generate editable Excalidraw diagrams and export them as PNG assets.",
  "scripts": {
    "render": "node render.mjs",
    "render:siphoning": "node render.mjs --input corporate-value-funnel-siphoning.js --output ../assets/corporate_value_funnel_siphoning.png"
  },
  "engines": {
    "node": ">=20.15.0"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
